# Copy this file to .env and replace every placeholder before running the app.

# Django
DEBUG=True
SECRET_KEY=replace-with-a-strong-django-secret-key

# PostgreSQL
DATABASE_NAME=market_lens_db
DATABASE_USER=postgres
DATABASE_PASSWORD=replace-with-your-postgres-password
DATABASE_HOST=database
DATABASE_PORT=5432
DATABASE_URL=postgresql://postgres:replace-with-your-postgres-password@database:5432/market_lens_db

# Meilisearch
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=replace-with-a-32-character-or-longer-master-key
# Create a search-only key restricted to the products index. Do not use the master key here.
NEXT_PUBLIC_MEILISEARCH_API_KEY=replace-with-a-products-search-only-key

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MEILISEARCH_HOST=http://localhost:7700
