# Market Lens Backend Configuration
# Copy this file to .env and update values for your environment

# ============ App Configuration ============
APP_NAME=Market Lens
APP_VERSION=1.0.0
ENVIRONMENT=development
# Options: development, staging, production
DEBUG=True

# ============ Server Configuration ============
HOST=0.0.0.0
PORT=8000

# ============ CORS Configuration ============
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=True
CORS_METHODS=GET,POST,PUT,DELETE
CORS_HEADERS=*

# ============ Database Configuration ============
DATABASE_NAME=market_lens
DATABASE_USER=market_lens_user
DATABASE_PASSWORD=replace-with-a-strong-password
DATABASE_HOST=localhost
DATABASE_PORT=5432
# Used by the crawler and batch indexer. This must be a psycopg-compatible URL.
DATABASE_URL=postgresql://market_lens_user:replace-with-a-strong-password@database:5432/market_lens

# ============ MongoDB Configuration (Optional, for backward compatibility) ============
MONGODB_URL=mongodb://localhost:27017/market_lens_db

# ============ Search and real-time configuration ============
MEILI_MASTER_KEY=replace-with-a-32-character-or-longer-secret
# This must be a Meilisearch search-only API key, never the master key.
NEXT_PUBLIC_MEILISEARCH_API_KEY=
NEXT_PUBLIC_MEILISEARCH_HOST=http://localhost:7700
NEXT_PUBLIC_API_URL=http://localhost:8000/api
REDIS_HOST=localhost
REDIS_PORT=6379

# ============ JWT & Security Configuration ============
# IMPORTANT: Generate a strong secret key for production!
# Run: python -c 'import secrets; print(secrets.token_urlsafe(32))'
SECRET_KEY=change-me-in-production-use-strong-random-key
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ============ Password Security Configuration ============
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPER=True
PASSWORD_REQUIRE_LOWER=True
PASSWORD_REQUIRE_DIGITS=True
PASSWORD_REQUIRE_SPECIAL=True

# ============ Logging Configuration ============
LOG_LEVEL=INFO
# Uncomment to enable file logging:
# LOG_FILE=logs/market_lens.log

# ============ Rate Limiting Configuration ============
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD_SECONDS=60

# ============ Pagination Configuration ============
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
